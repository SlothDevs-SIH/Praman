# =
# Anything left blank falls back to the default shown in the comment.

# --- Database ---
# Leave blank to use SQLite (zero setup, fine for demo).
# For Postgres paste a URL like: postgresql://user:pass@host:5432/dbname  (Render/Neon/Supabase free tier works)
DATABASE_URL=

# --- Security (leave blank and I will auto-generate strong random values) ---
JWT_SECRET=
RECORD_SIGNING_KEY=
APAAR_ENCRYPTION_KEY=

# --- Deployment ---
# Public URL of the frontend and backend once hosted (used in QR codes + CORS).
# Leave blank for localhost during development.
FRONTEND_URL=
BACKEND_URL=

# --- Bot protection (reference site uses Cloudflare Turnstile on login) ---
# Optional. Free at dash.cloudflare.com -> Turnstile. Blank =
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Email notifications (duplicate-enrolment handshake, upload reports) ---
# Optional. Blank =
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- AI layer (optional) : plain-language explanations of flagged anomalies ---
# Blank =
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Demo logins (change if you want) ---
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_INSTITUTION_EMAIL=
DEMO_INSTITUTION_PASSWORD=
